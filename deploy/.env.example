# Copy to ".env" and fill in. docker compose reads this file automatically.

# PostgreSQL password for the fleet database.
DB_PASSWORD=change-me-to-a-strong-password

# Shared enrollment token agents present on first registration.
# Generate one with:  openssl rand -hex 16
ENROLL_TOKEN=change-me-openssl-rand-hex-16

# Grafana admin password (only used by the optional monitoring profile).
GRAFANA_PASSWORD=change-me
